{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shorts Studio",
  "version": "0.1.0",
  "identifier": "com.sudoakshay.shortsstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shorts Studio",
        "width": 1440,
        "height": 900
      },
      {
        "label": "prompter",
        "title": "Prompter",
        "url": "index.html?window=prompter",
        "width": 720,
        "height": 320,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
